# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
.venv311/
venv/
ENV/

# Chrome Runtime Profiles & Logs
runtime/
logs/*.log
!logs/.gitkeep

# Provisioned browser extensions (downloaded on first use)
extensions/

# PyInstaller
*.manifest
*.spec
!yt_tool.spec

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local application state: per-machine settings, video queue and channels.
# Created with defaults on first run, so it never needs to be committed.
settings.json

# Per-video / per-channel watch statistics (created on first recorded run)
stats.json

# Configuration files with credentials (never commit)
credentials.json
